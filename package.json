{
  "name": "breakpoint-arena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@supabase/supabase-js": "2.39.0",
    "@reduxjs/toolkit": "2.2.1",
    "react-redux": "9.1.0",
    "@tanstack/react-query": "5.28.4",
    "react-hook-form": "7.51.0",
    "@hookform/resolvers": "3.3.4",
    "zod": "3.22.4",
    "date-fns": "3.3.1",
    "qrcode.react": "4.1.0",
    "html5-qrcode": "2.3.8",
    "razorpay": "2.9.2",
    "sonner": "1.4.3",
    "clsx": "2.1.0",
    "tailwind-merge": "2.2.1",
    "class-variance-authority": "0.7.0",
    "lucide-react": "0.344.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.0.0",
    "@types/node": "20.11.24",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "9.0.0",
    "eslint-config-next": "15.1.3",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "prettier": "3.2.5",
    "tailwindcss": "4.0.0",
    "typescript": "5.3.3",
    "husky": "9.0.11",
    "lint-staged": "15.2.2",
    "@upstash/redis": "1.28.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
