# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY.  Copy to .env.local and run.
#
#   cp .env.local.starter .env.local
#   npx supabase start
#   npx supabase db reset      # applies every migration, including otp_sessions
#   npm run check:env          # tells you if anything is missing
#   npm run dev
#
# Everything below is filled in with working local values, so the OTP login flow
# runs with no MSG91 account and no credits spent. The OTP is printed to the
# terminal running `npm run dev` instead of being sent by SMS.
#
# NONE of these values are usable in production. `npm run check:env` fails if it
# finds them anywhere other than a local run.
# ---------------------------------------------------------------------------

# --- Supabase (local) ------------------------------------------------------
# These are the standard Supabase local-development keys. They are the same on
# every machine, they are published in Supabase's own docs, and they only work
# against a database running on your laptop.
# If `npx supabase status` prints different values, use those instead.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- OTP login -------------------------------------------------------------
# Test mode: no MSG91 account needed. The OTP is printed to your terminal in a
# box like this, and you type that code into the browser:
#
#   ============================================================
#   MSG91 TEST MODE - OTP NOT SENT TO REAL PHONE
#   ============================================================
#   Phone: +91 9876543210
#   OTP:   482915
#   ============================================================
#
MSG91_TEST_MODE=true

# Left blank on purpose. With MSG91_TEST_MODE=true they are never read, and the
# account's key is not something that needs to be on a second laptop to work on
# this. Fill them in only if you are deliberately testing real SMS delivery.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BRKPNT
MSG91_TEMPLATE_ID_OTP=
MSG91_USE_SENDOTP_API=true
MSG91_LIVE_SMS_NUMBERS=

# REQUIRED - OTP sending throws without this, and it must be >= 32 characters.
# It keys the HMAC that OTP codes are hashed with, so reading the database
# cannot recover a code that is currently in flight.
#
# This placeholder is deliberately not a secret and is safe to commit, because
# it is refused outside local development. For a real deployment generate one:
#   openssl rand -hex 32
OTP_HASH_SECRET=local-development-only-do-not-use-in-production-0000
SESSION_SECRET=local-development-only-do-not-use-in-production-0000

# How long a customer stays signed in after verifying, in minutes (12 hours).
CUSTOMER_SESSION_MINUTES=720

# OTP tuning. Requests are also rate limited to one per 60 seconds per number -
# if testing trips that, run `npm run otp:reset` rather than waiting.
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_REQUESTS_PER_PHONE=3

# --- Razorpay (test) -------------------------------------------------------
# Only needed to take a payment at the end of a booking. The login flow, the
# food menu, subscriptions and Retrieve Booking all work without it.
#
# Leave blank and the app refuses to take payment rather than booking for free -
# that is intentional, not a bug. Ask for the shared test keys if you need to go
# through checkout; they look like rzp_test_xxxxxxxxxxxx.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAFE_NAME="Break Point Arena"

SLOT_LOCK_MINUTES=10
LATE_ARRIVAL_GRACE_MINUTES=15
ADVANCE_BOOKING_DAYS=7
